{{- /* Keep the English feed's article permalinks and GUIDs stable for re-imports. */ -}}
{{- $pages := .Site.RegularPages -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
  {{- $pages = first $limit $pages -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content on {{ .Site.Title }}</description>
    <generator>Hugo</generator>
    <language>{{ .Site.Language.LanguageCode }}</language>
    {{- with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range $pages }}
      {{- $pageURL := urls.Parse .Permalink -}}
      {{- $body := string .Content -}}
      {{- /* Feed readers resolve links outside the original article's URL context. */ -}}
      {{- range findRE "<(?:a|img|iframe|source|video|audio)\\b[^>]*>" $body -}}
        {{- $tag := . -}}
        {{- $updatedTag := $tag -}}
        {{- range findRESubmatch "\\s(?:src|href|poster)=(\"([^\"]*)\"|'([^']*)')" $tag -}}
          {{- $quoted := index . 1 -}}
          {{- $value := or (index . 2) (index . 3) -}}
          {{- with $value -}}
            {{- $url := urls.Parse (htmlUnescape .) -}}
            {{- if not $url.IsAbs -}}
              {{- $absolute := $pageURL.ResolveReference $url -}}
              {{- $attribute := index . 0 -}}
              {{- $prefix := strings.TrimSuffix $quoted $attribute -}}
              {{- $updatedTag = replace $updatedTag $attribute (printf "%s\"%s\"" $prefix (htmlEscape $absolute.String)) -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
        {{- $body = replace $body $tag $updatedTag -}}
      {{- end -}}
      {{- with .Params.cover -}}
        {{- if and .image (not .hidden) (not .hiddeninsingle) -}}
          {{- $image := absURL .image -}}
          {{- if .relative -}}
            {{- $image = ($pageURL.ResolveReference (urls.Parse .image)).String -}}
          {{- end -}}
          {{- $alt := .alt | default .caption | default "" | plainify | htmlEscape -}}
          {{- $cover := printf "<img src=\"%s\" alt=\"%s\">" (htmlEscape $image) $alt -}}
          {{- with .caption -}}
            {{- $cover = printf "%s<figcaption>%s</figcaption>" $cover (htmlEscape .) -}}
          {{- end -}}
          {{- $body = printf "<figure>%s</figure>%s" $cover $body -}}
        {{- end -}}
      {{- end -}}
      {{- $escapedBody := $body | transform.XMLEscape | safeHTML }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <description>{{ $escapedBody }}</description>
      <content:encoded>{{ $escapedBody }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
